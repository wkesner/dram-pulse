# Required for SEC EDGAR requests. Format: "MemorySignals your-name your-email"
SEC_USER_AGENT=MemorySignals your-name your-email

# OpenDART API key (40 characters). Required for Milestone 5 (Samsung / SK hynix DART).
# Get a key at https://opendart.fss.or.kr — never commit the real value.
DART_API_KEY=

# EDINET API key (Japan FSA). Free registration + MFA:
#   https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1
# Required for `python -m src.fetch_edinet`. Never commit the real value.
#
# Cloud Agents: a laptop-local .env is NOT visible to the VM. Add the same name
# as a Cursor environment secret (EDINET_API_KEY), or write it into this
# gitignored /workspace/.env on the agent machine, then re-run the agent turn.
EDINET_API_KEY=

# Companies House API key (UK). Free developer hub application:
#   https://developer.company-information.service.gov.uk/
# Required for `python -m src.fetch_companies_house`. Auth = Basic(key, "").
# Rate limit: 600 requests / 5 minutes. Never commit the real value.
COMPANIES_HOUSE_API_KEY=

# CNINFO (China A-share) needs no key — `python -m src.fetch_cninfo`.
# LSE RNS needs LSEG commercial credentials; FCA NSM has no public API yet.

# Auth mode: "single" (default typed-name votes) or "clerk" (multi-org demo).
AUTH_MODE=single

# --- Clerk (AUTH_MODE=clerk) ---
# Preferred setup with Clerk CLI (after `npx clerk@latest auth login`):
#   npx clerk@latest apps list --json          # pick app id if you have several
#   npx clerk@latest link --app <application_id>
#   npx clerk@latest env pull --file .env      # writes publishable + secret
#   npx clerk@latest enable orgs
# Or paste from Dashboard → API keys. Never commit real values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Frontend API URL / JWT issuer (optional if publishable key can derive it),
# e.g. https://upright-mouse-4959.clerk.accounts.dev
CLERK_ISSUER=
# Optional networkless JWT verify (PEM from Dashboard → API keys → JWKS Public Key)
CLERK_JWT_KEY=
# Comma-separated origins allowed in session token azp claim (CSRF hardening)
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000,http://localhost:8000

# Optional: shared secret for GET /api/operator/aggregates (X-Operator-Token header).
OPERATOR_TOKEN=
