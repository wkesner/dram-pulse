# Required for SEC EDGAR requests. Format: "ECSignals your-name your-email"
# (legacy "MemorySignals …" still accepted by the fetch client)
SEC_USER_AGENT=ECSignals your-name your-email

# OpenDART API key (40 characters). Required for Milestone 5 (Samsung / SK hynix DART).
# Get a key at https://opendart.fss.or.kr — never commit the real value.
DART_API_KEY=

# Auth mode: "single" (default typed-name votes) or "clerk" (multi-org demo).
AUTH_MODE=single

# --- Clerk (AUTH_MODE=clerk) ---
# Preferred setup with Clerk CLI (after `npx clerk@latest auth login`):
#   npx clerk@latest apps list --json          # pick app id if you have several
#   npx clerk@latest link --app <application_id>
#   npx clerk@latest env pull --file .env      # writes publishable + secret
#   npx clerk@latest enable orgs
# Or paste from Dashboard → API keys. Never commit real values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Frontend API URL / JWT issuer (optional if publishable key can derive it),
# e.g. https://upright-mouse-4959.clerk.accounts.dev
CLERK_ISSUER=
# Optional networkless JWT verify (PEM from Dashboard → API keys → JWKS Public Key)
CLERK_JWT_KEY=
# Comma-separated origins allowed in session token azp claim (CSRF hardening)
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000,http://localhost:8000

# Optional: shared secret for GET /api/operator/aggregates (X-Operator-Token header).
OPERATOR_TOKEN=
