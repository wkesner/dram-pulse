    <div style="text-align: center; text-indent: 36pt; font-family: 'Times New Roman'; font-size: 10pt; font-weight: bold;">ON SEMICONDUCTOR CORPORATION</div>
    <div style="text-align: center; font-family: 'Times New Roman'; font-size: 10pt; font-weight: bold;">UNAUDITED CONSOLIDATED STATEMENTS OF OPERATIONS</div>
    <div style="text-align: center; font-family: 'Times New Roman'; font-size: 10pt;">(in millions, except per share and percentage data)</div>
    <div style="text-align: center;"><font style="font-size: 10pt; font-family: 'Times New Roman';"> </font><font style="font-size: 10pt;"><br>
      </font></div>
    <table cellspacing="0" cellpadding="0" class="cfttable" id="z5c48966f4ba7464e8582bd2db05b1e36" style="font-family: 'Times New Roman'; font-size: 10pt; text-align: left; color: #000000; width: 100%;">

        <tr>
          <td valign="bottom" style="vertical-align: bottom; font-size: 10pt; padding-bottom: 2px;">&#160;</td>
          <td valign="bottom" class="cftguttercell" colspan="1" style="font-size: 10pt; vertical-align: bottom; padding-bottom: 2px;">&#160;</td>
          <td valign="bottom" colspan="10" style="vertical-align: bottom; font-size: 10pt; border-bottom: 2px solid rgb(0, 0, 0);">
            <div style="text-align: center; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-weight: bold;">Quarter Ended</div>
          </td>
          <td valign="bottom" nowrap="nowrap" class="cftfncell" colspan="1" style="font-size: 10pt; text-align: left; vertical-align: bottom; padding-bottom: 2px;">&#160;</td>
          <td valign="bottom" class="cftguttercell" colspan="1" style="font-size: 10pt; vertical-align: bottom; padding-bottom: 2px;">&#160;</td>
          <td valign="bottom" colspan="6" style="vertical-align: bottom; font-size: 10pt; border-bottom: 2px solid rgb(0, 0, 0);">
            <div style="text-align: center; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-weight: bold;">Year Ended</div>
          </td>
          <td valign="bottom" nowrap="nowrap" class="cftfncell" colspan="1" style="font-size: 10pt; text-align: left; vertical-align: bottom; padding-bottom: 2px;">&#160;</td>
        </tr>
        <tr>
          <td valign="bottom" style="vertical-align: bottom; font-size: 10pt; padding-bottom: 2px;">&#160;</td>
          <td valign="bottom" class="cftguttercell" colspan="1" style="font-size: 10pt; vertical-align: bottom; padding-bottom: 2px;">&#160;</td>
          <td valign="bottom" nowrap="nowrap" colspan="2" style="vertical-align: bottom; font-size: 10pt; border-bottom: #000000 solid 2px;">
            <div style="text-align: center; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-weight: bold;">December 31,</div>
