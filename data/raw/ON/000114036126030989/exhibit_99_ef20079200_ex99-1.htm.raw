                  <div><font style="font-size: 10pt; font-family: 'Times New Roman';">$</font></div>
                </td>
                <td valign="bottom" class="cftnumcell" colspan="1" style="vertical-align: bottom; text-align: right; width: 9%; background-color: #CCEEFF;">
                  <div><font style="font-size: 10pt; font-family: 'Times New Roman';">136.5</font></div>
                </td>
