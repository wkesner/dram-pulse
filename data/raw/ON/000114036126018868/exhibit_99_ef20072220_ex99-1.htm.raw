          </td>
          <td valign="bottom" nowrap="nowrap" class="cftfncell" colspan="1" style="text-align: left; vertical-align: bottom; width: 1%;">
            <div><font style="font-size: 10pt;"><font style="font-family: 'Times New Roman'; color: rgb(0, 0, 0);">%</font></font></div>
          </td>
