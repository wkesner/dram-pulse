     <td style="padding-top:0.02in;border-right:0.5pt solid;padding-left:0.02in;vertical-align:top;padding-bottom:0.02in;padding-right:0.02in;"><p style="font-size:11pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;margin-right:1.333%;text-align:center;"><font style="color:#000000;white-space:pre-wrap;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;">$1,025-1,075</font></p></td>
    </tr>
    <tr style="height:11pt;background-color:#ffffff;word-break:break-word;white-space:pre-wrap;text-align:left;">
     <td style="padding-top:0.02in;border-right:0.5pt solid;border-left:0.5pt solid;padding-left:0.02in;vertical-align:top;padding-bottom:0.02in;padding-right:0.02in;"><p style="font-size:11pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;margin-right:1.333%;text-align:left;"><font style="color:#000000;white-space:pre-wrap;font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;">Interest expense</font></p></td>
