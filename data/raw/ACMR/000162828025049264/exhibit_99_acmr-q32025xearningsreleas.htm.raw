="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="margin-bottom:1pt;margin-top:3.25pt;padding-right:-1.88pt;text-align:right"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:120%">$&#160;&#160;&#160;&#160;656,879&#160;&#160;&#160;&#160;</font></div></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="margin-bottom:1pt;margin-top:3.25pt;padding-right:-1.88pt;text-align:right"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:120%">$&#160;&#160;&#160;&#160;558,647&#160;&#160;&#160;&#160;</font></div></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="margin-bottom:1pt;margin-top:3.25pt;padding-right:-1.88pt;text-align:right"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:120%">$&#160;&#160;&#160;&#160;656,879&#160;&#160;&#160;&#160;</font></div></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="margin-bottom:1pt;margin-top:3.25pt;padding-right:-1.88pt;text-align:right"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:120%">$&#160;&#160;&#160;&#160;558,647&#160;&#160;&#160;&#160;</font></div></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:2px 1pt 2px 1.02pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Gross margin</font></td><td colspan="3" style="background-color:#fff