an><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_131bc5fb-c150-4ce1-8086-7b5876f6e38a" contextRef="C_8b89d828-75f8-4f14-937d-9ec8f5b9f8fc" name="us-gaap:EquitySecuritiesWithoutReadilyDeterminableFairValueAmount" unitRef="U_USD" scale="9" decimals="-8" format="ixt:num-dot-decimal">12.4</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;"> billion and $</span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_e10b644d-671e-492e-91c8-f0f62fd2cb4a" contextRef="C_34dc2009-5c47-4d6e-beb2-0af146fbbfb2" name="us-gaap:EquitySecuritiesWithoutReadilyDeterminableFairValueAmount" unitRef="U_USD" scale="9" decimals="-8" format="ixt:num-dot-decimal">2.9</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;"> billion, respectively</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">, and equity investments measured using the equity method were $</span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_221db1ed-7016-49d9-a8d1-10a4bb6dead4" contextRef="C_8b89d828-75f8-4f14-937d-9ec8f5b9f8fc" name="us-gaap:EquityMethodInvestments" unitRef="U_USD" scale="9" decimals="-8" format="ixt:num-dot-decimal">12.0</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;"> billion and $</span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_25accd13-3bb4-4261-86a4-45a28cf036c9" 