  <div class="main-content-container" style="z-index:5;position:relative;"><div style="font-size:10pt;font-family:Arial;"><ix:continuation id="F_27ec06a3-b475-4fd0-9fd0-49e95788a896_1"><p style="tab-size:26.66px;font-size:10pt;margin-top:13.5pt;font-family:Arial;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-weight:bold;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">Employee Stock Purchase Plan</span><span style="color:#000000;white-space:pre-wrap;font-weight:bold;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;"> </span></p><p style="tab-size:26.66px;font-size:10pt;margin-top:9pt;font-family:Arial;margin-bottom:0;text-align:justify;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">We have an ESPP for all eligible employees. Shares of our common stock may be purchased by employees at three-month intervals at </span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_440ea2b9-b4f7-4149-96f0-70bc0211ef21" contextRef="C_cef83b0b-5180-40c3-9cfe-4cc838aa0f9e" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardPurchasePriceOfCommonStockPercent" unitRef="U_pure" scale="-2" decimals="INF" format="ixt:num-dot-decimal"><ix:nonFraction id="F_d7ccaa32-7a02-492f-80c2-132088d4b8a4" contextRef="C_7220bb1d-4403-454e-a37e-5e370f4c8dbf" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardPurchasePriceOfCommonStockPercent" unitRef="U_pure" scale="-2" decimals="INF" format="ixt:num-dot-decimal"><ix:nonFraction id="F_4e29ccd7-afdf-4ef9-8b33-2dabbb3aa0b3" contextRef="C_d1ed490a-15fc-4468-9c3a-73d86d5a3c7b" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardPurchasePriceOfCommonStockPercent" unitRef="U_pure" scale="-2" decimals="INF" format="ixt:num-dot-decimal">90</ix:nonFraction></ix:nonFraction></ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">% of the fair market value on the last trading day of each three-month period. Employees may purchase shares having a value not exceeding </span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_819c88ec-d698-4f9b-a9b7-48b48e0d76ab" contextRef="C_af26cf2c-2698-4a88-8ccf-30193909f8c0" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardMaximumEmployeeSubscriptionRate" unitRef="U_pure" scale="-2" decimals="INF" format="ixt:num-dot-decimal"><ix:nonFraction id="F_7df2c93c-76b1-4e02-95f9-3e366661e5f5" contextRef="C_9058b307-84f2-4492-8ca5-54da6c138e6f" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardMaximumEmployeeSubscriptionRate" unitRef="U_pure" scale="-2" decimals="INF" format="ixt:num-dot-decimal"><ix:nonFraction id="F_d2f10bff-8010-422f-8fe4-0715b384e33c" contextRef="C_9ba36e47-bb8c-49e5-b84d-2a8348c01371" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardMaximumEmployeeSubscriptionRate" unitRef="U_pure" scale="-2" decimals="INF" format="ixt:num-dot-decimal">15</ix:nonFraction></ix:nonFraction></ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">% of their gross compensation during an offering period.</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;"> </span></p><div style="font-size:10pt;font-family:Arial;"><ix:nonNumeric id="F_1b56dc38-5124-4e68-bdab-6cc141a31c5e" contextRef="C_cc83aaed-4c2b-47e2-a694-c8c5f5fe3b56" name="us-gaap:ScheduleOfShareBasedCompensationEmployeeStockPurchasePlanActivityTableTextBlock" escape="true"><p style="tab-size:26.66px;font-size:10pt;margin-