     <td style="padding-top:0in;text-indent:2.5pt;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;"><p style="margin-left:0.467%;text-indent:0;font-size:12pt;margin-top:4.35pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#000000;white-space:pre-wrap;font-family:Arial;font-kerning:none;min-width:fit-content;">David Williams</font></p><p style="margin-left:0.467%;text-indent:0;font-size:8pt;margin-top:1.1pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#6e6e6e;white-space:pre-wrap;font-family:Arial;font-style:italic;font-kerning:none;min-width:fit-content;">Analyst, The Benchmark Co. LLC</font></p></td>
     <td style="padding-top:0in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;text-align:center;"><p style="font-size:28pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;margin-right:0.444%;text-align:right;"><font style="color:#a6a6a6;white-space:pre-wrap;font-family:Arial;font-kerning:none;min-width:fit-content;">Q</font></p></td>
