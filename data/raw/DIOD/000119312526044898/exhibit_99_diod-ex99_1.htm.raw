     <td style="padding-top:0.01in;white-space:nowrap;padding-left:0in;vertical-align:middle;padding-bottom:0in;border-bottom:2.25pt double #ffffff03;padding-right:0.01in;text-align:left;"><p style="font-size:8pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="font-family:'Calibri',sans-serif;font-kerning:none;min-width:fit-content;">&#160;</font></p></td>
