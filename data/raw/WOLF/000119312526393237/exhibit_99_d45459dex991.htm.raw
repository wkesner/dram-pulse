<TD VALIGN="bottom" COLSPAN="2" ALIGN="center" STYLE="border-bottom:1.00pt solid #000000"><B>For&nbsp;the&nbsp;year&nbsp;ended&nbsp;June&nbsp;28,<BR>2026</B></TD>
<TD VALIGN="bottom">&nbsp;</TD></TR>


<TR BGCOLOR="#cceeff" STYLE="page-break-inside:avoid ; font-family:Times New Roman; font-size:10pt">
<TD VALIGN="top"> <P STYLE=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman">Interest expense on New Senior Secured Notes</P></TD>
<TD VALIGN="bottom">&nbsp;&nbsp;</TD>
<TD NOWRAP VALIGN="bottom">$</TD>
<TD NOWRAP VALIGN="bottom" ALIGN="right">46.0</TD>
<TD NOWRAP VALIGN="bottom">&nbsp;</TD></TR>
