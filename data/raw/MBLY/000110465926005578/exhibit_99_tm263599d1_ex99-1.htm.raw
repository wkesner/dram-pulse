    <TD COLSPAN="2" STYLE="font: bold 10pt Times New Roman, Times, Serif; text-align: center; border-bottom: Black 1pt solid">Q1 2025</TD><TD STYLE="padding-bottom: 1pt; font: bold 10pt Times New Roman, Times, Serif">&nbsp;</TD><TD STYLE="font: bold 10pt Times New Roman, Times, Serif; padding-bottom: 1pt">&nbsp;</TD>
    <TD COLSPAN="2" STYLE="font: bold 10pt Times New Roman, Times, Serif; text-align: center; border-bottom: Black 1pt solid">Q2 2025</TD><TD STYLE="padding-bottom: 1pt; font: bold 10pt Times New Roman, Times, Serif">&nbsp;</TD><TD STYLE="font: bold 10pt Times New Roman, Times, Serif; padding-bottom: 1pt">&nbsp;</TD>
    <TD COLSPAN="2" STYLE="font: bold 10pt Times New Roman, Times, Serif; text-align: center; border-bottom: Black 1pt solid">Q3 2025</TD><TD STYLE="padding-bottom: 1pt; font: bold 10pt Times New Roman, Times, Serif">&nbsp;</TD><TD STYLE="font: bold 10pt Times New Roman, Times, Serif; padding-bottom: 1pt">&nbsp;</TD>
