    <TD STYLE="font: 10pt Times New Roman, Times, Serif; text-align: left">$</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; text-align: right">(30</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; text-align: left">)</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif">&nbsp;</TD>
