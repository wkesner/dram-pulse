    <TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">&nbsp;</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 10%; text-align: right">&mdash;</TD><TD STYLE="font: 10pt Times New Roman, Times, Serif; width: 1%; text-align: left">%</TD></TR>
