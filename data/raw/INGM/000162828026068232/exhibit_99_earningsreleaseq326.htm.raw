fffff;padding:0 1pt"></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:1.5pt 1pt 1.5pt 31pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Diluted</font></td><td style="background-color:#cceeff;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</font></td><td style="background-color:#cceeff;padding:1.5pt 0;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">0.91&#160;</font></td><td style="background-color:#cceeff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td style="background-color:#cceeff;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</font></td><td style="background-color:#cceeff;padding:1.5pt 0;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">0.72&#160;</font></td><td style="background-color:#cceeff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td></tr></table></div><div><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Consolidated Fiscal Third Quarter 2026 Financial Highlights</font></div><div style="text-align:justify"><font><br></font></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt">Net sales totaled $15.2 billion, compared to $12.6 billion in the prior fiscal third quarter, representing an increase of 20.8%. The growth was driven by year-over-year increases in net sales across each of our geographic segments. Globally, Advanced Solutions offerings increased by 40%, Client and Endpoint Solutions increased by 10%, Cloud-based Solutions increased by 31%, and Other services increased by 35%.  The translation impact of foreign currencies relative to the U.S. dollar did not have a notable impact on the year-over-year net sales comparison.  </font></div><div style="text-align:justify"><font><br></font></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt">Gross profit grew to $996.9 million, from $869.6 million in the prior fiscal third quarter.</font></div><div style="text-align:justify"><font><br></font></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt">Gross margin was 6.55%, compared to 6.90% in the prior fiscal third quarter. The increase in gross profit dollars was primarily attributable to the increase in our net sales. The year-over-year gross margin trend was largely driven by growth of lower-margin, low cost-to-serve GPU and AI-infrastructure product sets during the third quarter compared to the prior fiscal third quarter. Excluding these large deals, our gross margin was 7.06% in the fiscal third quarter 2026, roughly flat with 7.10% in the prior fiscal third quarter.</font></div><div style="text-align:justify"><font><br></font></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt">Income from operations was $293.8 million, compared to $223.5 million in the prior fiscal third quarter. The increase was primarily attributable to the previously described increase in our net sales coupled with leverage on our operating expenses.</font></div><div style="text-align:justify"><font><br></font></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt">Adjusted income from operations was $322.0 million, compared to $257.9 million in the prior fiscal third quarter. The increase was primarily attributable to the previously described increase in our net sales coupled with leverage on our operating expenses.</font></div><div style="text-align:justify"><font><br></font></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt">Income from operations margin was 1.93%, compared to 1.77% in the prior fiscal third quarter. Adjusted income from operations margin was 2.12% compared to 2.05% in the prior fiscal third quarter. The year-over-year comparisons are reflective of improved leverage on operating expenses, partially offset by a shift in sales mix towards lower-margin GPU and AI-infrastructure products in the current fiscal third quarter.</font></div><div style="text-align:justify"><font><br></font></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt">Adjusted EBITDA was $390.1 million, compared to $342.2 million in the prior fiscal third quarter.</font></div><div style="text-align:justify"><font><br></font></div><div style="height:72pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">2</font></div></div></div><hr style="page-break-after:always"><div style="min-height:72pt;width:100%"><div style="text-align:right"><font><br></font></div></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt">Diluted EPS was $0.57, compared to $0.42 in the prior fiscal third quarter. Non-GAAP diluted EPS was $0.91, compared to $0.72 in the prior fiscal third quarter &#8211; an increase of 26.4%.</font></div><div style="text-align:justify"><font><br></font></div><div style="padding-left:36pt;text-align:justify;text-indent:-18pt"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:112%">&#8226;</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:14.5pt">Cash provided in operations was $251.4 million, compared to $146.0 million used in the prior fiscal third quarter, and adjusted free cash flow was $249.5 million, compared to a use of $109.9 million in the prior fiscal third quarter. While our high sales growth levels require investment in net working capital, and particularly inventory and accounts receivable, we have financed this significantly with the accounts payable terms and conditions of our vendors, managing our net working capital conversion cycle multiple days better year-over-year.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Regional Fiscal Third Quarter 2026 Financial Highlights </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%">North America</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%"> </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Net sales were $5.8 billion, compared to $4.4 billion in the prior fiscal third quarter. The 31.5% year-over-year increase in North American net sales was primarily driven by a 61% increase in net sales of Advanced Solutions offerings, which includes growth in networking and servers in the United States as well as growth in GPU and AI-infrastructure product sets in the region. Net sales of Client and Endpoint Solutions increased by 7% driven by growth in notebooks and desktops, and net sales of Other services increased by 114% year-over-year, driven by growth in our U.S. Reverse Logistics and Repair business and, to a lesser degree, our re-entry into supply chain services. Net sales of Cloud-based Solutions increased by 21%, with growth in sales of infrastructure-as-a-service the primary catalyst. Excluding the impact of our CloudBlue divestiture, net sales of Cloud-based Solutions were up by 30% year-over-year.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Income from operations was $114.1 million, compared to $79.1 million in the prior fiscal third quarter and adjusted income from operations was $128.5 million compared to $96.5 million in the prior fiscal third quarter, representing increases of 44.2% and 33.2%, respectively.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Income from operations margin was 1.96%, compared to 1.79% in the prior fiscal third quarter. The increase was driven by a decrease in expenses as a percentage of net sales in the region, including a 102 basis point reduction in compensation and headcount expenses and a 12 basis point reduction in rental and occupancy costs largely as a result of the restructuring initiatives taken in the current and prior year, coupled with efficiencies of continued optimization and automation. The comparison benefited from the impact in the prior year period of write-downs relating to held-for-sale accounting of our CloudBlue operations and another non-core business, which had a negative impact of 12 basis points on the region&#8217;s income from operations margin in the prior fiscal third quarter.  These factors were partially offset by a decline in gross margin due to a shift in sales mix towards lower-margin, lower cost-to-serve GPU and AI-infrastructure product sets in the current year third quarter compared to the prior year third quarter.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%">EMEA</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%"> </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Net sales were $3.9 billion, an increase of 7.3% compared to the prior fiscal third quarter. The year-over-year increase in EMEA net sales was driven by 24% growth in Advanced Solutions led by growth in server and storage net sales, and 39% growth in Cloud-based Solutions, partially offset by a 1% decline in Client and Endpoint Solutions. The translation impact of foreign currencies relative to the U.S. dollar had a negative impact of 1% on the year-over-year net sales comparison.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Income from operations was $67.8 million, compared to $62.0 million in the prior fiscal third quarter and adjusted income from operations was $75.1 million compared to $69.5 million in the prior fiscal third quarter, representing increases of 9.4% and 8.1%, respectively. </font></div><div style="text-align:justify"><font><br></font></div><div style="height:72pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">3</font></div></div></div><hr style="page-break-after:always"><div style="min-height:72pt;width:100%"><div style="text-align:right"><font><br></font></div></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Income from operations margin was 1.72%, compared to 1.69% in the prior fiscal third quarter. The year-over-year increase in income from operations margin was driven by a decrease in expenses as a percentage of net sales in the region, including a 10 basis point reduction in compensation and headcount expenses and a 4 basis point reduction in rental and occupancy costs. These were partially offset by a decline in gross margin due to a shift in sales mix towards lower-margin product sets.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%">Asia-Pacific </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Net sales were $4.3 billion, compared to $3.5 billion in the prior fiscal third quarter. The 22.3% increase in Asia-Pacific net sales was driven by a 25% increase in net sales of Advanced Solutions offerings including GPU and AI-infrastructure product sets in China. Net sales of Client and Endpoint Solutions increased by 21% due to growth in mobility product sales. Net sales of Cloud-based Solutions increased by 44% and net sales of Other services increased by 39%. These were partially offset by the translation impact of foreign currencies relative to the U.S. dollar, which had a negative impact of 2% on the year-over-year net sales comparison.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:112%">Income from operations was $86.8 million, compared to $67.5 million in the prior fiscal third quarter and adjusted income from operations was $90.7 million compared to $72.0 million in the prior fiscal third quarter, representing increases of 28.6% and 25.9%, respectively. </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Income from operations margin was 2.00%, compared to 1.90% in the prior fiscal third quarter. The year-over-year increase was primarily driven by higher gross margin driven by growth in our higher-margin Cloud-based Solutions category, offset partially by continued strength in lower margin, lower cost-to-serve GPU and AI-Infrastructure product sets. These factors were further partially offset by an increase in expenses as a percentage of net sales in the region. The translation impact of foreign currencies relative to the U.S. dollar had a negative impact of 4 basis points on the year-over-year comparison of the region&#8217;s income from operations margin.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%">Latin America </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Net sales were $1.1 billion, compared to $1.0 billion in the prior fiscal third quarter. The 16.7% increase in Latin American net sales was primarily driven by 16% growth in net sales of Client and Endpoint Solutions due to growth in mobility product sales, 17% growth in Advanced Solutions, led by growth in server and cyber security, along with 56% growth in Cloud-based Solutions and 65% growth in Other Services. The translation impact of foreign currencies relative to the U.S. dollar had a positive impact of 6% on the year-over-year net sales comparison.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:112%">Income from operations was $38.8 million, compared to $31.0 million in the prior fiscal third quarter and adjusted income from operations was $39.6 million compared to $29.9 million in the prior fiscal third quarter, representing increases of 25.4% and 32.4%, respectively.  </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Income from operations margin was 3.45%, compared to 3.21% in the prior fiscal third quarter. The year-over-year increase was primarily a result of higher gross margin driven by a shift in sales mix towards our higher-margin Advanced Solutions and Cloud-based Solutions categories as described above. These factors were partially offset by an increase in expense as a percentage of net sales in the region.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Fiscal </font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Fourth Quarter</font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%"> </font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">2026</font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%"> Outlook</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The following outlook is forward-looking, based on the Company&#8217;s current expectations for the fiscal fourth quarter 2026, and actual results may differ materially from what is indicated. We provide EPS guidance on a non-GAAP basis because certain information necessary to reconcile such guidance to GAAP is difficult to estimate and dependent on future events outside of our control. See &#8220;Use of Non-GAAP Financial Measures,&#8221; below. </font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%"> </font></div><div style="text-align:justify"><font><br></font></div><div style="height:72pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">4</font></div></div></div><hr style="page-break-after:always"><div style="min-height:72pt;width:100%"><div style="text-align:right"><font><br></font></div></div><div style="text-align:justify"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"></td><td style="width:46.816%"></td><td style="width:0.1%"></td><td style="width:1.0%"></td><td style="width:23.419%"></td><td style="width:0.1%"></td><td style="width:0.1%"></td><td style="width:0.441%"></td><td style="width:0.1%"></td><td style="width:1.0%"></td><td style="width:25.824%"></td><td style="width:0.1%"></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td colspan="9" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:center;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:700;line-height:100%">Fourteen Weeks Ended January 2, 2027</font></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:700;line-height:100%">($ in millions, except per share data)</font></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:1.5pt 1pt;text-align:center;vertical-align:bottom"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:700;line-height:100%">Low</font></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:0 1pt"></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:1.5pt 1pt;text-align:center;vertical-align:bottom"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:700;line-height:100%">High</font></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Net sales</font></td><td style="background-color:#cceeff;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</font></td><td style="background-color:#cceeff;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">17,500&#160;</font></td><td style="background-color:#cceeff;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td style="background-color:#cceeff;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</font></td><td style="background-color:#cceeff;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">17,900&#160;</font></td><td style="background-color:#cceeff;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Gross profit</font></td><td style="background-color:#ffffff;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</font></td><td style="background-color:#ffffff;padding:1.5pt 0;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">1,075&#160;</font></td><td style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td style="background-color:#ffffff;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</font></td><td style="background-color:#ffffff;padding:1.5pt 0;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">1,115&#160;</font></td><td style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Non-GAAP diluted EPS</font></td><td style="background-color:#cceeff;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</font></td><td style="background-color:#cceeff;padding:1.5pt 0;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">1.05&#160;</font></td><td style="background-color:#cceeff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td style="background-color:#cceeff;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</font></td><td style="background-color:#cceeff;padding:1.5pt 0;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">1.15&#160;</font></td><td style="background-color:#cceeff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"></td></tr></table></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Our fiscal fourth quarter 2026 includes fourteen weeks of business while the prior fiscal fourth quarter included thirteen weeks. Our fiscal fourth quarter 2026 guidance assumes an effective tax rate of approxi</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">mately 27% on </font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">a non-GAAP</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%"> basis and 231.7 million dil</font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">uted shares outstanding.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">We also reaffirmed our multi-year financial framework introduced at September Capital Markets Day, summarized below&#58;</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"></td><td style="width:48.579%"></td><td style="width:0.1%"></td><td style="width:0.1%"></td><td style="width:0.441%"></td><td style="width:0.1%"></td><td style="width:1.0%"></td><td style="width:48.580%"></td><td style="width:0.1%"></td></tr><tr><td colspan="3" style="padding:1.5pt 1pt;text-align:center;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:700;line-height:100%">Metrics for Fiscal Years 2026-2029E</font></td><td colspan="3" style="padding:0 1pt"></td><td colspan="3" style="padding:1.5pt 1pt;text-align:center;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:700;line-height:100%">Targets</font></td></tr><tr><td colspan="3" style="background-color:#cceeff;border-top:1pt solid #000;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Net sales CAGR</font></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;border-top:1pt solid #000;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">&#126;4% to 6%</font></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Gross profit CAGR</font></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">&#126;5% to 7%</font></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Operating expenses (annual)</font></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">&#126;4.4% to 4.8% of net sales</font></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Non-GAAP net income CAGR</font></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">&#126;11% to 13%</font></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Adjusted free cash flow &#47; adjusted EBITDA (annual)</font></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="3" style="background-color:#cceeff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">&#126;30% or more</font></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">Adjusted ROIC (four-year average)</font></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">&#126;16% to 17%</font></td></tr></table></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Dividend Increase and Payment</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">On October&#160;29, 2026, the Company announced that its board of directors had declared a fourth quarter cash dividend on the Company&#8217;s common stock of $0.088 per share, representing a 2.3% increase from the quarterly dividend of $0.086 per share paid in the third quarter of 2026. The dividend is payable on November&#160;23, 2026, to stockholders of record as of November 9, 2026.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Fiscal Third Quarter</font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%"> </font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">2026</font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%"> </font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Earnings Call Details&#58; </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Ingram Micro&#8217;s management will host a call to discuss its results on </font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Thursday, October&#160;29, 2026</font><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%"> at 2&#58;00 p.m. Pacific time (5&#58;00 p.m. Eastern time). </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">A live webcast of the conference call will be accessible from the Ingram Micro investor relations website at https&#58;&#47;&#47;ir.ingrammicro.com. The call can also be accessed at 877-407-9781 or 201-689-8796.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">A replay of the webcast will also be available at https&#58;&#47;&#47;ir.ingrammicro.com.</font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">   </font></div><div style="text-align:justify"><font><br></font></div><div style="height:72pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">5</font></div></div></div><hr style="page-break-after:always"><div style="min-height:72pt;width:100%"><div style="text-align:right"><font><br></font></div></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">About Ingram Micro </font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Ingram Micro (NYSE&#58; INGM) is a leading technology company for the global information technology ecosystem. With the ability to reach nearly 90% of the global population, we play a vital role in the worldwide IT sales channel, bringing products and services from technology manufacturers and cloud providers to a highly diversified base of business-to-business technology experts. Through Ingram Micro Xvantage&#8482;, our AI-powered digital platform, we offer what we believe to be the industry&#8217;s first comprehensive business-to-consumer-like experience, integrating hardware and cloud subscriptions, personalized recommendations, instant pricing, order tracking, and billing automation. We also provide a broad range of technology services, including financing, specialized marketing, and lifecycle management, as well as technical pre- and post-sales professional support. Learn more at www.ingrammicro.com.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:6.5pt;font-weight:700;line-height:120%;position:relative;top:-3.5pt;vertical-align:baseline">(1)</font><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%"> Use of Non-GAAP Financial Measures</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">In addition to presenting financial results that have been prepared in accordance with accounting principles generally accepted in the United States (&#8220;GAAP&#8221;), we have included in this release some or all of the following non-GAAP financial measures&#8212;adjusted income from operations, EBITDA, adjusted EBITDA, return on invested capital (&#8220;ROIC&#8221;), adjusted ROIC, non-GAAP net income, adjusted free cash flow, and non-GAAP EPS&#8212;which are financial measures that are not required by, or presented in accordance with, GAAP. We believe that these non-GAAP financial measures are useful in evaluating our business and the underlying trends that are affecting our performance. These non-GAAP measures are primary indicators that our management uses internally to conduct and measure its business and evaluate the performance of its consolidated operations, ongoing results, and trends. Our management believes these non-GAAP financial measures are useful as they provide meaningful comparisons to prior periods and an alternate view of the impact of acquired businesses. These non-GAAP financial measures reflect an additional way of viewing aspects of our operations that, when viewed with our GAAP results and the accompanying reconciliations to corresponding GAAP financial measures, provide a more complete understanding of factors and trends affecting our business. A material limitation associated with these non-GAAP measures as compared to the GAAP measures is that they may not be comparable to other companies with similarly titled items that present related measures differently. The non-GAAP measures should be considered as a supplement to, and not as a substitute for or superior to, the corresponding measures calculated in accordance with GAAP. See &#8220;Schedule A&#58; Reconciliation of Non-GAAP Financial Measures&#8221; in the &#8220;Supplemental Information&#8221; section further below for reconciliations of non-GAAP financial measures to the most directly comparable financial measure stated in accordance with GAAP.</font></div><div style="text-align:justify"><font><br></font></div><div style="height:72pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">6</font></div></div></div><hr style="page-break-after:always"><div style="min-height:72pt;width:100%"><div style="text-align:right"><font><br></font></div></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Safe Harbor Statement</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">This release contains &#8220;forward-looking statements&#8221; within the meaning of Section 27A of the Securities Act of 1933, as amended, Section 21E of the Securities Exchange Act of 1934, as amended, and the Private Securities Litigation Reform Act of 1995. You can identify forward-looking statements because they contain words such as &#8220;believes,&#8221; &#8220;expects,&#8221; &#8220;may,&#8221; &#8220;will,&#8221; &#8220;should,&#8221; &#8220;seeks,&#8221; &#8220;intends,&#8221; &#8220;plans,&#8221; &#8220;estimates,&#8221; or &#8220;anticipates,&#8221; or similar expressions which concern our strategy, plans, projections or intentions, but such words are not the exclusive means of identifying forward-looking statements in this release. These forward-looking statements are included throughout this release and relate to matters such as our industry, growth strategy, goals and expectations concerning our market position, future operations, margins, profitability, capital expenditures, liquidity and capital resources, and other financial and operating information. By their nature, forward-looking statements&#58; speak only as of the date they are made&#59; are not statements of historical fact or guarantees of future performance&#59; and are subject to risks, uncertainties, assumptions or changes in circumstances that are difficult to predict or quantify. Our expectations, beliefs, and projections are expressed in good faith, and we believe there is a reasonable basis for them. However, there can be no assurance that management&#8217;s expectations, beliefs, and projections will result or be achieved, and actual results may vary materially from what is expressed in or indicated by the forward-looking statements. Certain important factors that involve risks and uncertainties and that could cause actual results to differ, possibly materially, from our expectations, beliefs, and projections reflected in such forward-looking statements can be found in the &#8220;Risk Factors&#8221; and &#8220;Cautionary Note Regarding Forward-Looking Statements&#8221; sections included in the Company&#8217;s Annual Report on Form 10-K and Quarterly Reports on Form 10-Q. We undertake no obligation to publicly update or review any forward-looking statement, whether as a result of new information, future developments or otherwise, except as may be required by any applicable securities laws. You should not place undue reliance on forward-looking statements, which speak only as of the date they are made.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">There are a number of risks, uncertainties, and other important factors that could cause our actual results to differ materially from the forward-looking statements contained in this release. Such risks, uncertainties, and other important factors include, among others, the risks, uncertainties, and factors included within the filings we make with the SEC from time to time and the following&#58; general economic conditions, including the impacts of the ongoing conflicts in the Middle East&#59; our estimates of the size of the markets for our products and services&#59; our ability to identify and integrate acquisitions and technologies into our platform&#59; our plans to continue to expand&#59; our ability to continue to successfully develop and deploy Ingram Micro Xvantage&#8482;&#59; our ability to retain and recruit key personnel&#59; the competition our products and services face and our ability to adapt to industry changes and market conditions, including inflation, market volatility, and supply constraints for many categories of technology&#59; current and potential litigation involving us&#59; the global nature of our business, including the various laws and regulations applicable to us now or in the future&#59; the effect of various political, geopolitical, and macroeconomic issues and developments, including changes in tariffs or global trade policies and the related uncertainties associated with such developments, import&#47;export and licensing restrictions, military conflicts, and our ability to comply with laws and regulations we are subject to, both in the United States and internationally&#59; our financing efforts, payment of dividends and stock repurchases&#59; our relationships with our customers, original equipment manufacturers, and suppliers&#59; our ability to maintain and protect our intellectual property&#59; the performance and security of our services, including information processing and cybersecurity provided by third parties&#59; our ownership structure&#59; our dependence upon Ingram Micro Inc. and its controlled subsidiaries for our results of operations, cash flows, and distributions&#59; and our status as a &#8220;controlled company&#8221; and the extent to which the interests of Platinum Equity, LLC together with its affiliated investment vehicles (&#8220;Platinum&#8221;) conflict with our interests or the interests of our stockholders.</font></div><div style="text-align:justify"><font><br></font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Ingram Micro, Xvantage&#8482;, and associated logos are trademarks of Ingram Micro Inc. (an indirect subsidiary of Ingram Micro Holding Corporation) or its licensors.</font></div><div style="margin-top:12pt;text-align:justify"><font><br></font></div><div style="margin-top:12pt;text-align:justify"><font><br></font></div><div style="margin-top:12pt;text-align:justify"><font><br></font></div><div style="height:72pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">7</font></div></div></div><hr style="page-break-after:always"><div style="min-height:72pt;width:100%"><div style="text-align:right"><font><br></font></div></div><div style="margin-top:12pt;text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Contact&#58;</font></div><div style="margin-top:5pt;text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Investor Relations&#58; </font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Willa McManmon </font></div><div style="text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">ir&#64;ingrammicro.com </font></div><div style="margin-top:9pt;text-align:justify"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height: