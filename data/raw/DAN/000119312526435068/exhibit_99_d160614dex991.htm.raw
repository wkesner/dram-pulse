&#8220;seek,&#8221; &#8220;predict,&#8221; &#8220;intend,&#8221; &#8220;strategy,&#8221; &#8220;plan,&#8221; &#8220;may,&#8221; &#8220;could,&#8221; &#8220;should,&#8221; &#8220;will,&#8221; &#8220;would,&#8221; &#8220;potential,&#8221;
