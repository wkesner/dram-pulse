       <td style="border-top:0.5pt solid #005496;padding-top:0.051in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;"><p style="font-size:7pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><font style="white-space:pre-wrap;font-family:Arial;font-kerning:none;min-width:fit-content;">&#160;</font></p></td>
