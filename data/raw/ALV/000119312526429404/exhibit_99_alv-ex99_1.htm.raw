     <tr style="height:9pt;background-color:#4f81bd;word-break:break-word;white-space:pre-wrap;text-align:left;">
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:middle;padding-bottom:0in;padding-right:0.01in;"><p style="tab-size:26.66px;font-size:9pt;margin-top:0;font-family:Arial;margin-bottom:0;text-align:left;"><font style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-kerning:none;min-width:fit-content;">9M 2026 organic growth*</font></p></td>
