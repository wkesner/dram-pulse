      <td style="padding-top:0.01in;padding-left:0in;vertical-align:top;padding-bottom:0in;border-bottom:0.5pt solid #000000;padding-right:0.01in;text-align:left;"><p style="tab-size:26.66px;font-size:9pt;margin-top:0;font-family:Arial;margin-bottom:0;text-align:left;"><font style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">Weighted average no. of shares in millions, diluted</font><font style="color:#000000;top:-4.221pt;white-space:pre-wrap;font-size:6.03pt;line-height:1.5;position:relative;font-kerning:none;min-width:fit-content;">2)</font></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:top;padding-bottom:0in;border-bottom:0.5pt solid #000000;padding-right:0.01in;text-align:center;"><p style="tab-size:26.66px;font-size:9pt;margin-top:0;font-family:Arial;margin-bottom:0;text-align:right;"><font style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">72.9</font></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:top;padding-bottom:0in;border-bottom:0.5pt solid #000000;padding-right:0.01in;text-align:center;"><p style="tab-size:26.66px;font-size:9pt;margin-top:0;font-family:Arial;margin-bottom:0;text-align:right;"><font style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">76.7</font></p></td>
