  <div class="main-content-container" style="z-index:5;position:relative;"><div class="fixed-width-container" style="margin-left:auto;padding-left:0.3in;width:7.67in;box-sizing:content-box;margin-right:auto;padding-right:0.3in;"><p style="tab-size:26.66px;font-size:16pt;margin-top:0;font-family:Arial;margin-bottom:0;text-align:left;"><font style="color:#0042a5;white-space:pre-wrap;font-size:16pt;font-family:Arial;font-kerning:none;min-width:fit-content;">Other Items</font></p><p style="margin-left:1.45pt;text-indent:-11.5pt;tab-size:26.66px;padding-left:11.5pt;font-size:9pt;margin-top:0;font-family:Arial;margin-bottom:0;text-align:left;"><font style="white-space:pre-wrap;font-size:9pt;font-family:Arial;font-kerning:none;min-width:fit-content;">&#160;</font></p>
