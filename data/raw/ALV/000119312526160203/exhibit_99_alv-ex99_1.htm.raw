  <div class="main-content-container" style="z-index:5;position:relative;"><div class="fixed-width-container" style="margin-left:auto;padding-left:0.3in;width:7.67in;box-sizing:content-box;margin-right:auto;padding-right:0.3in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="color:#0042a5;white-space:pre-wrap;font-size:14pt;font-family:Arial;font-kerning:none;min-width:fit-content;">Selected Cash Flow and Balance Sheet Items</font></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><font style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</font></p>
    <table style="margin-left:auto;border-spacing:0;table-layout:auto;width:99.0%;border-collapse:separate;margin-right:auto;">
     <tr style="visibility:collapse;">
      <td style="width:51.29%;box-sizing:content-box;"></td>
